# --- Keystatic ---
# local — правки пишутся в файлы репозитория (так работает npm run dev).
# github — правки на проде коммитятся в salmanbahaev/djawda через GitHub App.
# Если переменная не задана: в development используется local, в production — github.
# Задайте ОБЕ, они должны совпадать. NEXT_PUBLIC_ нужна админке в браузере.
KEYSTATIC_STORAGE=local
NEXT_PUBLIC_KEYSTATIC_STORAGE=local

# Только для GitHub-режима (прод на Vercel). Как получить — в README.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# --- Google Sheets ---
# Достаточно одного из двух способов ключа.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
# Либо весь JSON ключа одной строкой (удобно на Vercel):
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
